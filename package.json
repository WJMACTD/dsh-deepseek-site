{
  "name": "dsh-deepseek-site",
  "version": "1.6.0",
  "description": "Embed the DeepSeek official chat site inside the app: one live page instance behind a sidebar icon, a main panel and a conversation tab, kept alive across switches, with sign-in that survives restarts. · 应用内直达 DeepSeek 官网：三入口共用同一页面实例，切走不重载，重启免登录。",
  "type": "module",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "KLY",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "webview",
    "sidebar",
    "tabs",
    "keep-alive"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
