{
  "name": "dsh-deepseek-site",
  "version": "1.5.0",
  "description": "Left-sidebar entry that embeds the DeepSeek official chat site inside the app window and remembers the sign-in. · 左侧栏直达 DeepSeek 官网（应用内嵌 + 登录记忆）。",
  "type": "module",
  "icon": "icon.svg",
  "license": "MIT",
  "author": "KLY",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "webview",
    "sidebar"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
